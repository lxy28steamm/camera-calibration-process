# Copy to local.env and edit as needed. Relative data path is resolved at launch;
# use an absolute path for external storage. Leaving it unset uses package/data.
# CAMERA_DATA_DIR=/media/camera-storage/inspections
# Default auto detects the running device's LAN IPv4 on every start.
CAMERA_WEB_HOST=auto
# Optional advanced calibration environment:
# CAMERA_KALIBR_SETUP=/opt/kalibr/setup-camera.sh
# CONDA_BASE=/opt/miniforge3
# EGO_KALIBR_CONDA_ENV=ego-kalibr
# EGO_KALIBR_WS=/opt/kalibr_ws
CALIBRATION_THREADS=2
# Optional measured IMU noise file for the legacy desktop workflow:
# CAMERA_IMU_NOISE_YAML=/path/to/imu-noise.yaml

# Ego-Std write credential: local file only, not included in portable releases.
# Defaults to package/config/std-write.secret when present.
# YCTC_XU_UNLOCK_SECRET_FILE=/private/path/std-write.secret
