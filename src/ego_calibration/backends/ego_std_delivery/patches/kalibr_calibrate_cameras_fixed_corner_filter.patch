     return reader
 
+
+def isValidReprojectionResidual(reproj):
+    return not np.all(reproj == np.array([None, None]))
+
+
+def maximumCornerReprojectionResidual(calibrator):
+    max_residual = 0.0
+    valid_count = 0
+    for cidx in range(0, len(calibrator.cameras)):
+        corners, reprojs, rerrs = kcc.getReprojectionErrors(calibrator, cidx)
+        for batch_errors in rerrs:
+            if batch_errors is None:
+                continue
+            for reproj in batch_errors:
+                if isValidReprojectionResidual(reproj):
+                    max_residual = max(
+                        max_residual,
+                        np.linalg.norm(np.asarray(reproj, dtype=float)),
+                    )
+                    valid_count += 1
+    return max_residual, valid_count
+
+
+def runFixedCornerResidualFiltering(calibrator, parsed, removedOutlierCorners):
+    threshold = parsed.max_corner_reproj_px
+    print("")
+    print("Starting fixed corner residual filtering at {0:.6f} px...".format(threshold))
+    total_removed = 0
+    converged = False
+
+    for round_idx in range(0, parsed.max_corner_filter_rounds):
+        num_batches = calibrator.estimator.getNumBatches()
+        if num_batches == 0:
+            sm.logError("Fixed corner filtering removed every calibration view.")
+            break
+
+        round_removed = 0
+        progress_filter = sm.Progress2(num_batches)
+        progress_filter.sample()
+        batches_to_check = list(range(0, num_batches))
+        batches_to_check.reverse()
+
+        for batch_id in batches_to_check:
+            cornerRemovalList_allCams = list()
+            camerasInBatch = list(calibrator.views[batch_id].rerrs.keys())
+            for cidx in camerasInBatch:
+                corners, reprojs, rerrs = kcc.getReprojectionErrors(calibrator, cidx)
+                cornerRemovalList = list()
+                for pidx, reproj in enumerate(rerrs[batch_id]):
+                    if not isValidReprojectionResidual(reproj):
+                        continue
+                    reprojection_norm = np.linalg.norm(np.asarray(reproj, dtype=float))
+                    if reprojection_norm >= threshold:
+                        cornerRemovalList.append(pidx)
+                        removedOutlierCorners.append(
+                            (
+                                cidx,
+                                calibrator.views[batch_id].rerrs[cidx][pidx].getMeasurement(),
+                            )
+                        )
+                        if parsed.verbose or parsed.doPlotOutliers:
+                            sm.logInfo(
+                                "Fixed outlier on batch {0}, cam{1}, corner {2}: "
+                                "norm={3:.6f} >= {4:.6f} px".format(
+                                    batch_id,
+                                    cidx,
+                                    pidx,
+                                    reprojection_norm,
+                                    threshold,
+                                )
+                            )
+                cornerRemovalList_allCams.append((cidx, cornerRemovalList))
+
+            removeCount = sum(
+                [len(removelist) for cidx, removelist in cornerRemovalList_allCams]
+            )
+            if removeCount > 0:
+                original_batch = calibrator.views[batch_id]
+                new_batch = kcc.removeCornersFromBatch(
+                    original_batch,
+                    cornerRemovalList_allCams,
+                    useBlakeZissermanMest=parsed.doBlakeZisserman,
+                )
+                calibrator.estimator.removeBatch(calibrator.views[batch_id])
+                calibrator.views[batch_id] = new_batch
+                rval = calibrator.estimator.addBatch(new_batch, False)
+                if not rval.batchAccepted:
+                    sm.logDebug(
+                        "fixed-filtered view rejected; removing it from optimization..."
+                    )
+                    calibrator.views.remove(calibrator.views[batch_id])
+                round_removed += removeCount
+                total_removed += removeCount
+            progress_filter.sample()
+
+        max_residual, valid_count = maximumCornerReprojectionResidual(calibrator)
+        print(
+            "Fixed filter round {0}/{1}: removed {2} corners; "
+            "remaining max residual={3:.6f} px over {4} corners".format(
+                round_idx + 1,
+                parsed.max_corner_filter_rounds,
+                round_removed,
+                max_residual,
+                valid_count,
+            )
+        )
+        if valid_count > 0 and max_residual < threshold:
+            converged = True
+            break
+        if round_removed == 0:
+            break
+
+    final_max, final_count = maximumCornerReprojectionResidual(calibrator)
+    if not converged and final_count > 0 and final_max >= threshold:
+        sm.logWarn(
+            "Fixed corner filtering did not converge below {0:.6f} px; "
+            "remaining max residual is {1:.6f} px after {2} rounds.".format(
+                threshold, final_max, parsed.max_corner_filter_rounds
+            )
+        )
+    return total_removed, final_max, final_count
+
